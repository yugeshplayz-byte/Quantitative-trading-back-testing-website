# ---------------------------------------------------------------
# Copy the relevant block to the file noted. NEVER commit real values.
# ---------------------------------------------------------------

# ===== backend/.env =====
# SQLite for local development (default). Use a PostgreSQL URL in production, e.g.
# DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./quant.db

# Comma-separated browser origins allowed to call the API (CORS). No wildcard.
# Local dev:   http://localhost:3000
# Production:  https://your-app.vercel.app   (add custom domains too)
ALLOWED_ORIGINS=http://localhost:3000

# Optional regex for Vercel preview deployments, e.g. ^https://your-app-.*\.vercel\.app$
ALLOWED_ORIGIN_REGEX=

# Strategy Lab: runs pasted Python on the server = arbitrary code execution.
# Keep false on any shared/public host. Set true only on a machine you control.
ENABLE_CUSTOM_CODE=false
# If you host with custom code enabled, require this token (header X-Admin-Token).
CUSTOM_CODE_TOKEN=
# Seconds allowed per sandboxed strategy run.
CUSTOM_CODE_TIMEOUT=180

# Create the demo backtests on an empty database (set false to start empty).
SEED_DEMO_DATA=true

# Recorded on every experiment (auto-detected from git when available).
GIT_COMMIT=

# ===== frontend/.env.local (also set in Vercel project settings) =====
# Base URL of the FastAPI backend, no trailing slash. Baked in at BUILD time.
NEXT_PUBLIC_API_URL=http://localhost:8000
