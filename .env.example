# ---------------------------------------------------------------
# Copy this file to the places noted below. NEVER commit real values.
# ---------------------------------------------------------------

# ===== backend/.env =====
# SQLite for local development (default). Use a PostgreSQL URL in production, e.g.
# DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./quant.db

# Comma-separated list of browser origins allowed to call the API (CORS).
# Local dev:      http://localhost:3000
# Production:     https://your-app.vercel.app   (add your custom domain too if you have one)
ALLOWED_ORIGINS=http://localhost:3000

# Optional regex for Vercel preview deployments, e.g. ^https://your-app-.*\.vercel\.app$
ALLOWED_ORIGIN_REGEX=

# Optional: recorded on every experiment so results are traceable to code.
# (Auto-detected from `git rev-parse` locally; set it on hosts without git.)
GIT_COMMIT=

# ===== frontend/.env.local =====
# Base URL of the FastAPI backend (no trailing slash). No default is baked into the production build.
NEXT_PUBLIC_API_URL=http://localhost:8000
